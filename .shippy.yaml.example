# Shippy - TYPO3 Deployment Configuration
# This is an example configuration file showing all available options

hosts:
  staging:
    # SSH connection details
    hostname: staging.example.com
    port: 22  # SSH port (default: 22)
    remote_user: deploy
    ssh_key: ~/.ssh/id_rsa

    # SSH multiplexing: reuse one TCP connection for all SSH operations
    # Improves performance by avoiding reconnection overhead
    # Default: false (disabled)
    ssh_multiplexing: true

    # Optional: Advanced SSH options (see man ssh_config)
    # ssh_options:
    #   ConnectTimeout: "10"
    #   ServerAliveInterval: "60"
    #   Compression: "yes"
    #   StrictHostKeyChecking: "no"

    # Deployment configuration
    deploy_path: /var/www/{{name}}
    rsync_src: ./
    keep_releases: 5  # Number of releases to keep (default: 5)

    # File selection is DENY-BY-DEFAULT (an allowlist): nothing is deployed
    # unless it is listed under 'include:' below. A directory entry ships that
    # directory and everything beneath it. Note: .gitignore is NOT consulted for
    # deployment - list what you want shipped explicitly.
    include:
      - "public/"            # Web root (ships everything under it)
      - "vendor/"            # Composer dependencies
      - "config/"            # TYPO3 configuration
      - "composer.json"
      - "composer.lock"

    # Optional: Carve-outs. Excludes always WIN over includes, so use them to
    # punch holes in an included directory. Common junk (.git/, node_modules/,
    # var/cache/, .DS_Store, ...) is excluded automatically - no need to list it.
    exclude:
      - "public/typo3temp/"  # Don't ship generated temp files
      - "*.log"              # Never ship log files

    # Shared files/directories (symlinked from shared/ to each release)
    shared:
      - .env
      - var/log/
      - var/session/
      - public/fileadmin/
      - public/uploads/

  production:
    hostname: www.example.com
    port: 2222  # Example: custom SSH port
    remote_user: deploy
    deploy_path: /var/www/{{name}}/production
    rsync_src: ./
    ssh_key: ~/.ssh/id_rsa_production
    ssh_multiplexing: true  # Enable for faster deployments
    keep_releases: 10
    # Deny-by-default: each host needs its own allowlist (include/exclude are not
    # merged across hosts - a per-host list replaces the one above entirely).
    include:
      - "public/"
      - "vendor/"
      - "config/"
      - "composer.json"
      - "composer.lock"
    shared:
      - .env
      - var/log/
      - var/session/
      - public/fileadmin/
      - public/uploads/

# Backup configuration
# Used by: shippy backup [host]
# Creates a ZIP with database dump + specified files
backup:
  # Local directory for backup files (default: current directory)
  output: ./backups

  # Files and directories to include from the shared/ directory
  # Only listed paths are downloaded (relative to shared/)
  files:
    - .env
    - public/fileadmin/
    - public/uploads/

  database:
    # How to obtain credentials: "auto" (default), "dotenv", "typo3", "manual"
    # auto:   tries `typo3 configuration:show` (TYPO3 v14+), then .env keys,
    #         TYPO3 .env keys, then TYPO3 settings.php
    # dotenv: reads standard .env keys (DB_HOST, DB_DATABASE, etc.)
    # typo3:  tries `typo3 configuration:show` (TYPO3 v14+), then TYPO3-specific
    #         .env keys or settings.php
    # manual: uses the driver/host/port/name/user/password fields below
    # credentials: auto
    #
    # When available, "auto"/"typo3" run
    # ./vendor/bin/typo3 configuration:show DB/Connections/Default
    # to read the authoritative database configuration, falling back to
    # .env / settings.php parsing if the command is unavailable.

    # Manual database credentials (used when credentials: manual)
    # Supports environment variables: ${DB_PASSWORD}
    # driver: mysql           # mysql, postgresql, sqlite
    # host: 127.0.0.1
    # port: 3306
    # name: my_database
    # user: db_user
    # password: ${DB_PASSWORD}

    # Tables to exclude from backup (glob patterns supported)
    exclude_tables:
      - "cache_*"
      - "cf_*"
      - "sys_log"
      - "be_sessions"

    # DBMS-specific options
    options:
      single_transaction: "true"  # MySQL: consistent dump without locking
      # charset: "utf8mb4"       # MySQL: character set
      # schema: "public"         # PostgreSQL: schema to dump

# Commands to run after deployment (on remote server)
# Optional: Run every command inside a subcontext, e.g. a container.
# Useful when the PHP sources are mounted into a container and PHP commands
# must run there. When set, each command is executed as:
#   <command_context> sh -c 'cd <release-dir> && <run>'
# so shippy adds the `sh -c` itself — give only the container-entry prefix,
# WITHOUT a trailing shell (use "docker exec php85", not "docker exec php85 bash").
#
# The `cd` happens inside the context, so the release directory must resolve to
# the same path there — the normal bind-mount case (e.g. /var/www:/var/www).
# Empty (default) runs commands directly on the remote host.
#
# Precedence: per-command > per-host (hosts.<name>.command_context) > this global.
# command_context: docker exec -u www-data php85

commands:
  - name: Clear TYPO3 cache
    run: ./vendor/bin/typo3 cache:flush

  - name: Run extension setup
    run: ./vendor/bin/typo3 extension:setup

  - name: Database migrations
    run: ./vendor/bin/typo3 upgrade:run
    # Only run this command for the listed host(s) (keys under `hosts:`).
    # Skipped everywhere else. GitLab-CI-style; omit for "runs on every host".
    only:
      - production

  - name: Warmup caches
    run: ./vendor/bin/typo3 cache:warmup

  # except is the inverse of only: runs everywhere except the listed hosts.
  # - name: Notify host monitoring
  #   run: /usr/local/bin/notify-deploy
  #   except:
  #     - staging

  # Per-command override: set an empty command_context to force a single command
  # to run on the host even when a global/per-host context is configured.
  # - name: Notify host monitoring
  #   run: /usr/local/bin/notify-deploy
  #   command_context: ""

# Optional: Commands to run after rollback (on remote server)
# Executed in the rolled-back release directory after the "current" symlink
# is switched. Unlike "commands" above, rollback commands have no defaults —
# rollback only swaps the symlink unless you configure commands here.
rollback_commands:
  - name: Flush caches
    run: ./vendor/bin/typo3 cache:flush

  - name: Warmup caches
    run: ./vendor/bin/typo3 cache:warmup
